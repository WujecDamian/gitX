{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",

    // 🌟 Prisma's Mandatory Requirements
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",

    // 🛠️ Necessary Express Backend Tweaks
    "types": ["node"],                           /* Keeps global types like 'process' working */
    "jsx": "preserve",                           /* Safe default for backend code */
    
    // Modern Safety Options (from your original file)
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*","src/**/*.ts", "src/**/*.tsx", "global.d.ts"]
}

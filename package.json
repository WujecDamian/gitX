{
  "name": "gitx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
     "// --- DEVELOPMENT ---": "",
    "dev:server": "tsx watch Backend/src/app.ts",
    
    "dev:client": "vite", 
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",

    "// --- PRODUCTION BUILDS ---": "",
    "build:server": "tsc --project Backend/tsconfig.json",
    
    "build:client": "vite build", 
    "build": "npm run build:server && npm run build:client"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.1"
  }
}

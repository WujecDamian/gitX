{
  "name": "gitx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "// --- DEVELOPMENT ---": "",
    "dev:server": "tsx watch Backend/src/app.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "// --- PRODUCTION BUILDS ---": "",
    "build:server": "tsc --project Backend/tsconfig.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "concurrently": "^10.0.4",
    "connect-redis": "^10.0.0",
    "cookie-session": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "redis": "^6.1.0",
    "redis-server": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.1"
  }
}

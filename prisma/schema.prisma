// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../Backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//possible invitation statuse
enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

//When I use {onDelete: Cascade}? On child elements, it's saying 'If parent gets deleted, delete its children also (sad :c)'

model User {
  id                  String        @id @default(uuid())
  github_id           String        @unique
  email               String?       @unique
  username            String        @unique
  display_name        String
  github_profile_url  String?
  profile_picture_url String?
  banner_picture_url  String?
  tags                String[]
  socials             String[]
  bio                 String?
  createdAt           DateTime      @default(now())
  posts               Post[]
  followers           Follows[]     @relation("UserFollowing")
  following           Follows[]     @relation("UserFollowers")
  post_likes          PostLike[]
  comment_likes       CommentLike[]
  bookmarks           Bookmark[]
  groups              Group[]
  group_inviting      GroupInvite[] @relation("SentInvites")
  group_invited       GroupInvite[] @relation("ReceivedInvites")
  comments            Comment[]
}

model Follows {
  id           String @id @default(uuid())
  follower_id  String
  following_id String
  follower     User   @relation("UserFollowers", fields: [follower_id], references: [id], onDelete: Cascade)
  following    User   @relation("UserFollowing", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id]) //prevention from following one user multiple times
}

model Post {
  id        String     @id @default(uuid())
  content   String
  media_url String?
  author    User       @relation(fields: [author_id], references: [id], onDelete: Cascade)
  author_id String
  createdAt DateTime   @default(now())
  comments  Comment[]
  postLikes PostLike[]

  group     Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String?
  bookmarks Bookmark[]
}

model Comment {
  id           String        @id @default(uuid())
  content      String
  media_url    String?
  author       User          @relation(fields: [author_id], references: [id], onDelete: Cascade)
  author_id    String
  post         Post          @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id      String
  createdAt    DateTime      @default(now())
  commentLikes CommentLike[]

  parent_comment Comment?  @relation("comment_children", fields: [sub_comment_id], references: [id])
  sub_comments   Comment[] @relation("comment_children")
  sub_comment_id String?
}

model PostLike {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id   String
  post      Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id   String
  createdAt DateTime @default(now())

  @@unique([post_id, user_id])
}

model CommentLike {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String
  comment    Comment  @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  comment_id String
  createdAt  DateTime @default(now())

  @@unique([comment_id, user_id])
}

model Bookmark {
  id      String @id @default(uuid())
  post    Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  @@unique([post_id, user_id])
}

model Group {
  id                        String        @id @default(uuid())
  group_name                String
  group_profile_picture_url String        @default("https://static.vecteezy.com/system/resources/previews/026/019/617/non_2x/group-profile-avatar-icon-default-social-media-forum-profile-photo-vector.jpg")
  creator_id                String
  createdAt                 DateTime      @default(now())
  members                   User[]
  posts                     Post[]
  groupInvites              GroupInvite[]
  groupChats                GroupChat[]
}

model GroupInvite {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  invitedById String
  invitedBy   User   @relation("SentInvites", fields: [invitedById], references: [id])

  inviteeId String
  invitee   User   @relation("ReceivedInvites", fields: [inviteeId], references: [id])
}

//* CHAT AND MESSAGES
model Chat {
  id       String    @id @default(uuid())
  messages Message[]
  user1_id String
  user2_id String

  @@unique([user1_id, user2_id])
}

model GroupChat {
  id       String    @id @default(uuid())
  messages Message[]
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id])
}

model Message {
  id            String     @id @default(uuid())
  content       String
  media_url     String?
  createdAt     DateTime   @default(now())
  senderId      String
  chat          Chat?      @relation(fields: [chat_id], references: [id], onDelete: Cascade) // <- where message was sent?
  chat_id       String?
  group_chat    GroupChat? @relation(fields: [group_chat_id], references: [id], onDelete: Cascade)
  group_chat_id String?
}

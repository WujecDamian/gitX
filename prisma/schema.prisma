// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../Backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//possible invitation statuse
enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

//When I use {onDelete: Cascade}? On child elements, it's saying 'If parent gets deleted, delete its children also (sad :c)'

model User {
  id                  String        @id @default(uuid())
  github_id           String        @unique
  email               String?       @unique
  username            String        @unique
  display_name        String
  github_profile_url  String?
  profile_picture_url String?
  banner_picture_url  String?
  tags                String[]
  socials             String[]
  bio                 String?
  createdAt           DateTime      @default(now())
  posts               Post[]
  followers           Follows[]     @relation("UserFollowers")
  following           Follows[]     @relation("UserFollowing")
  post_likes          PostLike[]
  comment_likes       CommentLike[]
  bookmarks           Bookmark[]
  groups              Group[]
  messages            Message[]
  chats               Chat[]
  group_inviting      GroupInvite[] @relation("SentInvites")
  group_invited       GroupInvite[] @relation("ReceivedInvites")
  comments            Comment[]
}

model Follows {
  id           String @id @default(uuid())
  follower_id  String
  following_id String
  follower     User   @relation("UserFollowers", fields: [follower_id], references: [id], onDelete: Cascade)
  following    User   @relation("UserFollowing", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id]) //prevention from following one user multiple times
}

model Post {
  id        String     @id @default(uuid())
  content   String
  media_url String?
  author    User       @relation(fields: [author_id], references: [id], onDelete: Cascade)
  author_id String
  createdAt DateTime   @default(now())
  comments  Comment[]
  postLikes PostLike[]

  group     Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String?
  bookmarks Bookmark[]
}

model Comment {
  id           String        @id @default(uuid())
  content      String
  media_url    String?
  author       User          @relation(fields: [author_id], references: [id], onDelete: Cascade)
  author_id    String
  post         Post          @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id      String
  createdAt    DateTime      @default(now())
  commentLikes CommentLike[]

  parent_comment Comment?  @relation("comment_children", fields: [sub_comment_id], references: [id])
  sub_comments   Comment[] @relation("comment_children")
  sub_comment_id String?
}

model PostLike {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id   String
  post      Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id   String
  createdAt DateTime @default(now())

  @@unique([post_id, user_id]) // Czysty, bezpieczny klucz bez NULLi
}

model CommentLike {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String
  comment    Comment  @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  comment_id String
  createdAt  DateTime @default(now())

  @@unique([comment_id, user_id]) // Czysty, bezpieczny klucz bez NULLi
}

model Bookmark {
  id      String @id @default(uuid())
  post    Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  @@unique([post_id, user_id])
}

model Group {
  id           String        @id @default(uuid())
  group_name   String
  creator_id   String
  createdAt    DateTime      @default(now())
  members      User[]
  posts        Post[]
  chat         Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId       String        @unique
  groupInvites GroupInvite[]
}

model GroupInvite {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  invitedById String
  invitedBy   User   @relation("SentInvites", fields: [invitedById], references: [id])

  inviteeId String
  invitee   User   @relation("ReceivedInvites", fields: [inviteeId], references: [id])
}

model Chat {
  id       String    @id @default(uuid())
  messages Message[]
  users    User[] // <- chat can have multiple users (for group chats)
  groups   Group? // <- one chat can have one group (but not always so "?" optional )
}

model Message {
  id        String   @id @default(uuid())
  content   String
  media_url String?
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade) // <- where message was sent?
  chat_id   String
  user      User?    @relation(fields: [user_id], references: [id], onDelete: Cascade) // <- we have to know who sent message
  user_id   String?
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//possible invitation statuses
enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

//When I use {onDelete: Cascade}? On child elements, it's saying 'If parent gets deleted, delete its children also (sad :c)'

model User {
  id                  String        @id @default(uuid())
  username            String        @unique
  display_name        String
  password            String
  profile_picture_url String        @default("https://i.pinimg.com/474x/13/74/20/137420f5b9c39bc911e472f5d20f053e.jpg")
  banner_picture_url  String        @default("https://www.mub.eps.manchester.ac.uk/science-engineering/wp-content/themes/uom-theme/assets/images/default-banner.jpg")
  tags                String[]
  socials             String[]
  bio                 String?
  createdAt           DateTime      @default(now())
  posts               Post[]
  followers           Follows[]     @relation("UserFollowers")
  following           Follows[]     @relation("UserFollowing")
  likes               Like[]
  bookmarks           Bookmark[]
  groups              Group[]
  messages            Message[]
  chats               Chat[]
  group_inviting      GroupInvite[] @relation("SentInvites")
  group_invited       GroupInvite[] @relation("ReceivedInvites")
}

model Follows {
  id           String @id @default(uuid())
  follower_id  String
  following_id String
  follower     User   @relation("UserFollowers", fields: [follower_id], references: [id], onDelete: Cascade)
  following    User   @relation("UserFollowing", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id]) //prevention from following one user multiple times
}

model Post {
  id        String     @id @default(uuid())
  content   String
  media_url String?
  author    User       @relation(fields: [author_id], references: [id], onDelete: Cascade)
  author_id String
  createdAt DateTime   @default(now())
  comments  Comment[]
  likes     Like[]
  group     Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String?
  bookmarks Bookmark[]
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  media_url String?
  post      Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id   String
  createdAt DateTime @default(now())
  likes     Like[]
}

model Like {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String
  post       Post?    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id    String?
  comment    Comment? @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  comment_id String?

  @@unique([post_id, user_id], name: "unique_post_like")
  @@unique([comment_id, user_id], name: "unique_comment_like") //prevention from liking one post/comment multiple times
}

model Bookmark {
  id      String @id @default(uuid())
  post    Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  @@unique([post_id, user_id])
}

model Group {
  id           String        @id @default(uuid())
  group_name   String
  creator_id   String
  createdAt    DateTime      @default(now())
  members      User[]
  posts        Post[]
  chat         Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId       String        @unique
  groupInvites GroupInvite[]
}

model GroupInvite {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  invitedById String
  invitedBy   User   @relation("SentInvites", fields: [invitedById], references: [id])

  invitingId String
  inviting   User   @relation("ReceivedInvites", fields: [invitingId], references: [id])
}

model Chat {
  id       String    @id @default(uuid())
  messages Message[]
  users    User[] // <- chat can have multiple users (for group chats)
  groups   Group? // <- one chat can have one group (but not always so "?" optional )
}

model Message {
  id        String   @id @default(uuid())
  content   String
  media_url String?
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade) // <- where message was sent?
  chat_id   String
  user      User?    @relation(fields: [user_id], references: [id], onDelete: Cascade) // <- we have to know who sent message
  user_id   String?
}
